# PostgreSQL (Neon). Havuzlu adres uygulama için, doğrudan adres migration'lar için.
DATABASE_URL="postgresql://KULLANICI:SIFRE@HOST-pooler.REGION.aws.neon.tech/VERITABANI?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://KULLANICI:SIFRE@HOST.REGION.aws.neon.tech/VERITABANI?sslmode=require"

# Canonical URL, sitemap ve Open Graph için. Yayında sitenin gerçek adresi (örn. https://proje.vercel.app).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Arama motorlarına açık mı? Boş / tanımsız = KAPALI (robots.txt her şeyi yasaklar, sayfalara noindex eklenir).
# Deneme ve test yayınlarında BOŞ bırakın. Yalnızca gerçek yayına çıkarken 1 yapın.
# SITE_INDEXABLE=1

# E-posta (Resend, resend.com). RESEND_API_KEY bos ise e-postalar gonderilmez, sunucu konsoluna yazilir.
# MAIL_FROM: dogrulanmis alan adindan gonderen (ornek: Mert Kitap <siparis@alanadi.com>). Bos ise Resend deneme adresi kullanilir
# (yalnizca kendi hesap e-postaniza gonderebilir). ADMIN_NOTIFY_EMAIL: yeni siparis / mesaj bildirimi adresi (bos ise site.email).
# RESEND_API_KEY=
# MAIL_FROM=
# ADMIN_NOTIFY_EMAIL=

# Günlük temizlik görevi (süresi dolmuş oturum / deneme sınırı / bağlantı kayıtları): /api/cron/temizlik. Vercel Cron bu
# değeri "Authorization: Bearer ..." başlığıyla gönderir. Yayında Vercel ortam değişkenlerine uzun rastgele bir değer girin
# (örn. `openssl rand -hex 32`); boşsa uç nokta kapalıdır (401).
# CRON_SECRET=
