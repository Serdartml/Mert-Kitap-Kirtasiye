# HTTPS sertifikasını Caddy kendisi alır ve yeniler (Let's Encrypt). SITE_DOMAIN compose.yml'den gelir (örn. mertkitap.com.tr).
{
	servers {
		# Cloudflare proxy (turuncu bulut) açılırsa gerçek ziyaretçi adresi CF-Connecting-IP başlığındadır. Bu başlığa
		# YALNIZCA Cloudflare'in adreslerinden gelen isteklerde güvenilir; başkası başlığı uydurarak deneme sınırını
		# (lib/rate-limit.ts) atlatamaz. Proxy kapalıyken (gri bulut) doğrudan bağlanan adres kullanılır.
		# Liste: https://www.cloudflare.com/ips/ (nadiren değişir).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy app:3000 {
		# Uygulama istemci adresini buradan okur (lib/rate-limit.ts, clientIp).
		header_up X-Real-IP {client_ip}
	}
}
